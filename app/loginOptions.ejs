<div id="loginOptionsContainer" style="display: none;">
    <div id="loginOptionsContent">
        <div class="loginOptionsMainContent">
            <h1><%- lang('loginOptions.loginOptionsTitle') %></h1>
            <div class="loginOptionActions">
                <div class="loginOptionButtonContainer">
                    <button class="loginOptionButton" id="loginOptionMicrosoft">
                        <svg width="24" height="24" viewBox="0 0 23 23" style="margin-right: 10px;">
                            <path fill="#f35325" d="M1 1h10v10H1z" />
                            <path fill="#81bc06" d="M12 1h10v10H12z" />
                            <path fill="#05a6f0" d="M1 12h10v10H1z" />
                            <path fill="#ffba08" d="M12 12h10v10H12z" />
                        </svg>
                        <span><%- lang('loginOptions.loginWithMicrosoft') %></span>
                    </button>
                </div>
                <div class="loginOptionButtonContainer">
                    <button class="loginOptionButton" id="loginOptionMojang">
                        <svg width="24" height="24" viewBox="0 0 9.677 9.667" style="margin-right: 10px;">
                            <path d="M2.598.022h7.07L9.665 7c-.003 1.334-1.113 2.46-2.402 2.654H0V2.542C.134 1.2 1.3.195 2.598.022z" fill="#db2331" />
                            <path d="M1.54 2.844c.314-.76 1.31-.46 1.954-.528.785-.083 1.503.272 2.1.758l.164-.9c.327.345.587.756.964 1.052.28.254.655-.342.86-.013.42.864.408 1.86.54 2.795l-.788-.373C6.9 4.17 5.126 3.052 3.656 3.685c-1.294.592-1.156 2.65.06 3.255 1.354.703 2.953.51 4.405.292-.07.42-.34.87-.834.816l-4.95.002c-.5.055-.886-.413-.838-.89l.04-4.315z" fill="#fff" />
                        </svg>
                        <span><%- lang('loginOptions.loginWithMojang') %></span>
                    </button>
                </div>
                <div class="loginOptionButtonContainer">
                    <button class="loginOptionButton" id="loginOptionOffline">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="white" style="margin-right: 10px;">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                        </svg>
                        <span><%- lang('loginOptions.loginOffline') %></span>
                    </button>
                </div>
            </div>
        </div>
        <div id="loginOptionCancelContainer">
            <button id="loginOptionCancelButton"><%- lang('loginOptions.cancelButton') %></button>
        </div>
    </div>
</div>

<!-- ОКНО ВВОДА НИКА (ЖЕСТКО СКРЫТО) -->
<div id="offlineLoginModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(5px);">
    <div style="background: #171614; padding: 30px; border-radius: 8px; border: 1px solid #FF9800; width: 320px; text-align: center; box-shadow: 0 0 20px rgba(255,152,0,0.3);">
        <h2 style="color: #FF9800; margin-top: 0; font-size: 20px;"><%- lang('loginOptions.offlineModalTitle') %></h2>
        <p style="font-size: 12px; color: #ccc; margin-bottom: 15px;"><%- lang('loginOptions.offlineModalDesc') %></p>
        <input type="text" id="offlineNickInput" style="width: 100%; padding: 10px; margin-bottom: 15px; border: 1px solid #333; background: #000; color: #fff; border-radius: 4px; text-align: center; font-size: 16px; outline: none; box-sizing: border-box;" placeholder="Steve" maxlength="16">
        <button id="offlinePlayBtn" style="width: 100%; background: #FF9800; color: #000; border: none; padding: 12px; font-weight: bold; border-radius: 4px; cursor: pointer; margin-bottom: 10px; font-size: 14px;"><%- lang('loginOptions.offlineModalPlay') %></button>
        <button id="offlineCancelBtn" style="width: 100%; background: transparent; color: #ccc; border: 1px solid #444; padding: 10px; font-weight: bold; border-radius: 4px; cursor: pointer; font-size: 14px;"><%- lang('loginOptions.offlineModalCancel') %></button>
    </div>
</div>

<script src="./assets/js/scripts/loginOptions.js"></script>
