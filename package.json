{
  "name": "lesonos-launcher",
  "version": "1.0.2",
  "productName": "LesonOS Launcher",
  "description": "Modded Minecraft Launcher",
  "author": "lesono (https://lesonos-mc.duckdns.org/)",
  "license": "UNLICENSED",
  "homepage": "https://lesonos-mc.duckdns.org/",
  "bugs": {
    "url": "https://lesonos-mc.duckdns.org/"
  },
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder build",
    "dist:win": "npm run dist -- -w",
    "dist:mac": "npm run dist -- -m",
    "dist:linux": "npm run dist -- -l",
    "dist:all": "electron-builder -mwl",
    "lint": "eslint ."
  },
  "engines": {
    "node": "22.x.x"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "adm-zip": "^0.5.16",
    "discord-rpc-patch": "^4.0.1",
    "ejs": "^3.1.10",
    "ejs-electron": "^3.0.0",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "github-syntax-dark": "^0.5.0",
    "got": "^11.8.5",
    "helios-core": "~2.3.0",
    "helios-distribution-types": "^1.3.0",
    "jquery": "^3.7.1",
    "lodash.merge": "^4.6.2",
    "semver": "^7.7.3",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2"
  },
  "build": {
    "appId": "org.lesonos.launcher",
    "productName": "LesonOS Launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "jlecu4ka",
        "repo": "LesonOS-Launcher"
      }
    ],
    "nsis": {
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "target": ["AppImage"],
      "artifactName": "LesonOS-Launcher.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "LesonOS-Launcher-Setup.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "artifactName": "LesonOS-Launcher-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jlecu4ka/LesonOS-Launcher.git"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@39.8.10": true
  }
}
